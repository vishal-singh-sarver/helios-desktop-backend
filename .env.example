# ──────────────────────────────────────────────
# HeliosGUI Backend — environment configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development            # development | staging | production
BACKEND_VERSION=1.0.0
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ── Server ────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true                    # uvicorn --reload (development only)

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,tauri://localhost,http://localhost:1427

# ── Storage paths ─────────────────────────────
DATA_DIR=data                  # root data directory (relative to project root)
# DB_PATH and PROJECTS_DIR are derived from DATA_DIR unless overridden
# DB_PATH=data/heliosgui.db
# PROJECTS_DIR=data/projects

# ── Database ──────────────────────────────────
# SQLite is used by default. Override DB_PATH for a custom location.
DB_ECHO=false                  # set true to log all SQL queries

# ── PyHelios ──────────────────────────────────
PYHELIOS_USE_PIP=false         # false = use source submodule, true = use pip pyhelios3d
# PYHELIOS_SOURCE_PATH=         # override path to pyhelios source (auto-detected if blank)

# ── Security ──────────────────────────────────
# Used for signing internal tokens if authentication is added later
SECRET_KEY=change-me-to-a-long-random-string
